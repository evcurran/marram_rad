library(data.table)
library(dplyr)
outliers <- as.data.table(outliers)
# Create ±100 kb windows around each outlier SNP
outliers[, start := pmax(0, pos - 100000)]
outliers[, end := pos + 100000]
outliers[, chrom := as.character(chrom)]  # make sure it's character type
# Read GFF, skipping the header lines starting with ##
gff <- fread("marram_annotation_no_comment.gff3", fill=TRUE, header = FALSE)
setDT(gff)
setDT(outliers)
# Columns based on GFF3 spec
setnames(gff, old = names(gff),
new = c("seqid", "source", "type", "start", "end",
"score", "strand", "phase", "attributes"))
# Filter to 'gene' rows and keep relevant columns
genes <- gff[type == "gene", list(seqid, start, end, attributes)]
View(genes)
# Extract gene IDs from the attributes column
genes[, gene_id := sub(".*ID=([^;]+).*", "\\1", attributes)]
View(genes)
genes[, seqid := as.character(seqid)]
# Prepare SNPs and genes as data.tables with key columns
setkey(genes, seqid, start, end)
setkey(outliers, chrom, start, end)
# Perform the overlap
hits <- foverlaps(outliers, genes, by.x = c("chrom","start","end"),
by.y = c("seqid","start","end"), type = "any", nomatch = 0)
View(hits)
View(snps)
View(outliers)
# Load universe + candidate genes
geneUniverse <- scan("gene_universe_list.txt", what="")
sigGenes <- scan("candidate_gene_list.txt", what="")
# Build binary vector
geneList <- factor(as.integer(geneUniverse %in% sigGenes))
names(geneList) <- geneUniverse
# Load GO mapping
geneID2GO <- readMappings("marram_gene2go.map")
## TopGO gene ontology enrichment
library(topGO)
# Load GO mapping
geneID2GO <- readMappings("marram_gene2go.map")
# Create topGO object
GOdata <- new("topGOdata",
ontology = "BP",
allGenes = geneList,
geneSelectionFun = function(x) x == 1,
annot = annFUN.gene2GO,
gene2GO = geneID2GO)
# Run enrichment
resultFisher <- runTest(GOdata, algorithm="weight01", statistic="fisher")
# Output
goResults <- GenTable(GOdata,
weightFisher = resultFisher,
orderBy = "weightFisher",
topNodes = 30)
write.csv(goResults, "topGO_results_BP.csv", row.names=FALSE)
View(goResults)
